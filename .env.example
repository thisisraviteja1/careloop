# Copy to .env and fill in. Never commit .env.

# --- Ring ---------------------------------------------------------------
# Ring Developer Playground > Generate Token. Lives about 30 minutes.
RING_ACCESS_TOKEN=
# live = call api.amazonvision.com, fixture = read fixtures/ring_*.json
RING_MODE=fixture
# Optional: pin a device. Empty = first device returned by /v1/devices.
RING_DEVICE_ID=
POLL_INTERVAL_SECONDS=60

# --- Amazon Bedrock -----------------------------------------------------
# Credentials come from `aws configure` (or AWS_PROFILE / standard AWS env vars).
AWS_REGION=us-east-1
BEDROCK_VISION_MODEL_ID=
BEDROCK_TEXT_MODEL_ID=

# --- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ELDER=
TELEGRAM_CHAT_CAREGIVER=
TELEGRAM_CHAT_NEIGHBOR=

# --- People (fictional names only) -------------------------------------
PERSON_NAME=Lakshmi
CAREGIVER_NAME=Suresh
NEIGHBOR_NAME=Meena

# --- Detection ----------------------------------------------------------
TIMEZONE=Asia/Kolkata
MARGIN_MINUTES=45

# --- Escalation ---------------------------------------------------------
L1_WAIT_MINUTES=30
L2_WAIT_MINUTES=30
# Long random string used to sign ack tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACK_SECRET=change-me
# Base URL used in ack links sent to people
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- App ----------------------------------------------------------------
DATABASE_URL=sqlite:///careloop.db
DEMO_MODE=true
# Demo clock speed: 60 means 30 simulated minutes take 30 real seconds
CLOCK_SPEED=60
LOG_LEVEL=INFO
